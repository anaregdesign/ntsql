      "case_id": "target.identifier.maximum.accepted",
      "constraint": "identifier maxLength 128",
      "patch": [
        {
          "op": "copy",
          "from": "/targets/0",
          "path": "/targets/-"
        },
        {
          "op": "replace",
          "path": "/targets/1/id",
