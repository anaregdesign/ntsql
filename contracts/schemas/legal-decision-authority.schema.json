{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anaregdesign/ntsql/contracts/schemas/legal-decision-authority.schema.json",
  "title": "ntsql authenticated legal-decision authority",
  "description": "Out-of-branch GitHub pull-request evidence and reviewer trust used to authenticate legal decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_repository",
    "candidate_commit_sha",
    "trusted_reviewer_account_ids",
    "pull_requests"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "candidate_repository": { "$ref": "#/$defs/repository" },
    "candidate_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "trusted_reviewer_account_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "pull_requests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pullRequest" }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_id", "decision", "provenance_records"],
      "properties": {
        "attestation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "decision": {
          "$ref": "legal-review-ledger.schema.json#/$defs/review"
        },
        "provenance_records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "provenance-ledger.schema.json#/$defs/record"
          }
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pull_request_number",
        "pull_request_author_account_id",
        "candidate_commit_sha",
        "authenticated_reviews"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "pull_request_number": { "type": "integer", "minimum": 1 },
        "pull_request_author_account_id": { "type": "integer", "minimum": 1 },
        "candidate_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authenticated_reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/authenticatedReview" }
        }
      }
    },
    "authenticatedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pull_request_number",
        "review_id",
        "reviewer",
        "reviewed_commit_sha",
        "state",
        "submitted_at",
        "attestations"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "pull_request_number": { "type": "integer", "minimum": 1 },
        "review_id": { "type": "integer", "minimum": 1 },
        "reviewer": {
          "$ref": "legal-review-ledger.schema.json#/$defs/reviewer"
        },
        "reviewed_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "state": {
          "enum": [
            "approved",
            "dismissed",
            "changes-requested",
            "commented"
          ]
        },
        "submitted_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "attestations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/attestation" }
        }
      }
    }
  }
}
