{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anaregdesign/ntsql/contracts/schemas/legal-review-ledger.schema.json",
  "title": "ntsql legal review ledger",
  "description": "Human-owned legal decisions for governed provenance uses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviews"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonWhitespaceString": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_account_id", "github_login"],
      "properties": {
        "github_account_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "github_login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?!-))*[A-Za-z0-9]$|^[A-Za-z0-9]$"
        }
      }
    },
    "nullableReviewer": {
      "oneOf": [
        { "$ref": "#/$defs/reviewer" },
        { "type": "null" }
      ]
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        { "type": "null" }
      ]
    },
    "use": {
      "enum": [
        "documentation-reference",
        "implementation-input",
        "dependency-inclusion",
        "supply-chain-verification",
        "project-licensing",
        "contribution-policy",
        "oracle-operation",
        "conformance-evidence",
        "fixture",
        "release-claim"
      ]
    },
    "uses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/use" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request_number", "attestation_id"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "attestation_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "nullableEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/evidence" },
        { "type": "null" }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "status",
        "approved_uses",
        "prohibited_uses",
        "individual_review_uses",
        "source_provenance_ids",
        "reviewed_by",
        "decided_on",
        "decision_evidence",
        "rationale"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/nonWhitespaceString" },
        "status": { "enum": ["pending", "approved", "rejected"] },
        "approved_uses": { "$ref": "#/$defs/uses" },
        "prohibited_uses": { "$ref": "#/$defs/uses" },
        "individual_review_uses": { "$ref": "#/$defs/uses" },
        "source_provenance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "reviewed_by": { "$ref": "#/$defs/nullableReviewer" },
        "decided_on": { "$ref": "#/$defs/nullableDate" },
        "decision_evidence": { "$ref": "#/$defs/nullableEvidence" },
        "rationale": { "$ref": "#/$defs/nonWhitespaceString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "approved_uses": { "maxItems": 0 },
              "prohibited_uses": { "maxItems": 0 },
              "individual_review_uses": { "maxItems": 0 },
              "reviewed_by": { "type": "null" },
              "decided_on": { "type": "null" },
              "decision_evidence": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "properties": {
              "approved_uses": { "minItems": 1 },
              "reviewed_by": { "$ref": "#/$defs/reviewer" },
              "decided_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "decision_evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } } },
          "then": {
            "properties": {
              "approved_uses": { "maxItems": 0 },
              "reviewed_by": { "$ref": "#/$defs/reviewer" },
              "decided_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "decision_evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        }
      ]
    }
  }
}