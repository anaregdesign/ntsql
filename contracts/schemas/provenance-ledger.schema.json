{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anaregdesign/ntsql/contracts/schemas/provenance-ledger.schema.json",
  "title": "ntsql provenance ledger",
  "description": "Sources, repository artifacts, lineage, and requested governed uses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonWhitespaceString": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "nullableString": {
      "oneOf": [
        { "$ref": "#/$defs/nonWhitespaceString" },
        { "type": "null" }
      ]
    },
    "use": {
      "enum": [
        "documentation-reference",
        "implementation-input",
        "dependency-inclusion",
        "supply-chain-verification",
        "project-licensing",
        "contribution-policy",
        "oracle-operation",
        "conformance-evidence",
        "fixture",
        "release-claim"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_kind",
        "title",
        "source_url",
        "artifact_path",
        "revision",
        "retrieved_on",
        "author",
        "generation_method",
        "environment",
        "license",
        "content_digest",
        "intended_uses",
        "parent_provenance_ids",
        "legal_review_id"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source_kind": {
          "enum": [
            "public-documentation",
            "open-specification",
            "standard",
            "public-api",
            "legal-terms",
            "oracle-observation",
            "behavior-specification",
            "source-code",
            "test",
            "fixture",
            "dependency",
            "generated-artifact"
          ]
        },
        "title": { "$ref": "#/$defs/nonWhitespaceString" },
        "source_url": { "$ref": "#/$defs/nullableString" },
        "artifact_path": { "$ref": "#/$defs/nullableString" },
        "revision": { "$ref": "#/$defs/nonWhitespaceString" },
        "retrieved_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "author": { "$ref": "#/$defs/nonWhitespaceString" },
        "generation_method": { "$ref": "#/$defs/nonWhitespaceString" },
        "environment": { "$ref": "#/$defs/nullableString" },
        "license": { "$ref": "#/$defs/nonWhitespaceString" },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9A-Fa-f]{64}$"
        },
        "intended_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/use" }
        },
        "parent_provenance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "legal_review_id": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "public-documentation",
                  "open-specification",
                  "standard",
                  "public-api",
                  "legal-terms",
                  "dependency"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_url": { "type": "string", "pattern": "^https://" },
              "artifact_path": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "source_url": { "type": "null" },
              "artifact_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/\\\\][^\\\\]*$",
                "not": { "pattern": "(^|/)\\.\\.(/|$)" }
              }
            }
          }
        }
      ]
    }
  }
}