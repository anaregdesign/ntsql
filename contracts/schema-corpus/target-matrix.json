{
  "corpus_version": "1.0.0",
  "schema_id": "https://github.com/anaregdesign/ntsql/contracts/schemas/target-matrix.schema.json",
  "base_document": {
    "source": "../compatibility/targets.json"
  },
  "cases": [
    {
      "case_id": "target.base.valid",
      "constraint": "published target matrix",
      "patch": [],
      "expected": {
        "json_schema": true,
        "rust_deserialize": true,
        "rust_schema_semantics": true,
        "rust_full_validation": true
      }
    },
    {
      "case_id": "target.required.baseline-missing",
      "constraint": "required property",
      "patch": [
        { "op": "remove", "path": "/baseline_target_id" }
      ],
      "expected": {
        "json_schema": false,
        "rust_deserialize": false,
        "rust_schema_semantics": false,
        "rust_full_validation": false
      }
    },
    {
      "case_id": "target.additional-property.rejected",
      "constraint": "additionalProperties false",
      "patch": [
        { "op": "add", "path": "/unexpected", "value": true }
      ],
      "expected": {
        "json_schema": false,
        "rust_deserialize": false,
        "rust_schema_semantics": false,
        "rust_full_validation": false
      }
    },
    {
      "case_id": "target.integer.maximums.accepted",
      "constraint": "u16 and u32 maximums",
      "patch": [
        { "op": "replace", "path": "/targets/0/compatibility_level", "value": 65535 },
        { "op": "replace", "path": "/targets/0/lcid", "value": 4294967295 },
        { "op": "replace", "path": "/expansion_order/0/sequence", "value": 1 }
      ],
      "expected": {
        "json_schema": true,
        "rust_deserialize": true,
        "rust_schema_semantics": true,
        "rust_full_validation": true
      }
    },
    {
      "case_id": "target.compatibility-level.overflow",
      "constraint": "u16 maximum",
      "patch": [
        { "op": "replace", "path": "/targets/0/compatibility_level", "value": 65536 }
      ],
      "expected": {
        "json_schema": false,
        "rust_deserialize": false,
        "rust_schema_semantics": false,
        "rust_full_validation": false
      }
    },
    {
      "case_id": "target.compatibility-level.integral-decimal-prefilter",
      "constraint": "JSON Schema integer accepts an integral decimal representation",
      "patch": [
        { "op": "replace", "path": "/targets/0/compatibility_level", "value": 160.0 }
      ],
      "expected": {
        "json_schema": true,
        "rust_deserialize": false,
        "rust_schema_semantics": false,
        "rust_full_validation": false
